# ============================================================
# CUE — Supabase edge-function secrets (server-side)
# ============================================================
# 1. Copy this file:   cp supabase/.env.example supabase/.env
# 2. Fill in the real values in supabase/.env
# 3. Push to Supabase (uploads every KEY here as a Supabase secret):
#      supabase secrets set --env-file ./supabase/.env
#
# supabase/.env is gitignored — the real key stays on your machine.
# Never put these keys in the frontend `.env` or any VITE_* variable.
# ============================================================

# Anthropic API key — used by supabase/functions/autofill-metadata
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
