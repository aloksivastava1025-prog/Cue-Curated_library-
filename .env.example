# CUE — environment template.
# Copy to `.env` and fill in the real values. Do NOT commit `.env`.

# Clerk auth — from Clerk dashboard (API Keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_or_pk_live_...

# Supabase — Project Settings → API
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...

# Sentry — Project Settings → Client Keys (DSN)
VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Toggle after Clerk-Supabase JWT template is wired on both sides.
# Leave false for local dev; flip to true BEFORE running the security
# lockdown migration (supabase-migration-security-lockdown.sql).
VITE_USE_CLERK_SUPABASE_JWT=false
