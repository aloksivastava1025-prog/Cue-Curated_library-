# ============================================================
# CUE v2.0 — Environment Variables Template
# ============================================================
# Copy to `.env` and fill in the real values. Do NOT commit `.env`.
# For Vercel: set these in Project Settings → Environment Variables.
# For Supabase Edge Functions: use `npx supabase secrets set KEY=val`.
# ============================================================

# ---- CLIENT-SIDE (exposed in browser bundle) -----------------
# Only public/publishable keys go here. NEVER put secrets in VITE_*.

# Clerk auth — from Clerk dashboard (API Keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_or_pk_live_...

# Supabase — Project Settings → API
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...

# Sentry — Project Settings → Client Keys (DSN)
VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Toggle after Clerk-Supabase JWT template is wired on both sides.
# Leave false for local dev; flip to true BEFORE running the security
# lockdown migration (supabase-migration-security-lockdown.sql).
VITE_USE_CLERK_SUPABASE_JWT=false


# ---- SERVER-SIDE ONLY (Supabase Edge Function Secrets) -------
# Set via: npx supabase secrets set KEY=value
# NEVER put these in VITE_* variables.

# Dodo Payments — from Dodo dashboard
# DODO_PAYMENTS_API_KEY=sk_live_...
# DODO_WEBHOOK_SECRET=whsec_...
# DODO_PRODUCT_ID_INDIVIDUAL=prod_...    (CUE+ Individual $79)
# DODO_PRODUCT_ID_TEAM=prod_...          (CUE+ Team $249)
# DODO_ENV=test                          (or 'live' for production)

# Anthropic — for AI autofill (admin feature)
# ANTHROPIC_API_KEY=sk-ant-...

# Resend — for transactional email (welcome, receipt, reply notifications)
# RESEND_API_KEY=re_...

# Cloudflare Turnstile — for CAPTCHA on waitlist/feedback
# TURNSTILE_SECRET=0x...

# SMTP (legacy, for send-contact edge function)
# SMTP_PASSWORD=your_gmail_app_password

# Supabase service role (auto-set in Edge Functions, but documented here)
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...
